#!/usr/bin/env python3
"""Create a deterministic, secret-safe evaluator package."""

from __future__ import annotations

import argparse
import hashlib
import os
import subprocess
import sys
import zipfile
from pathlib import Path, PurePosixPath


ROOT = Path(__file__).resolve().parent
DEFAULT_NAME = "hackerrank-amazon-rl-gym-pilot"

# TRUSTED-OPERATOR package: the vendor runs the whole gym themselves (generate ->
# verify -> benchmark), so the golden reference solution, the calibration anchors
# (hollow + mutants), and the generation image/prompt (verifier/amazon-test) ARE
# shipped -- they let the operator self-validate the verifier and generate
# candidates. Only secrets, machine-specific run output, and internal notes are
# withheld. (.gitignore already drops verifier.env, runs/, verifier-logs/, docs/,
# node_modules/, __pycache__/, so those never reach `git ls-files` below.)
REJECTED = {
    "prepare-export",                 # the packager itself
    "verifier/verifier.env",          # real credentials (also gitignored)
    "verifier.env",
    "candidate-workspace",
    "verifier-results",
    "dist",
    # live/regenerated + internal-only artifacts:
    "benchmark.md",                   # regenerated by ./benchmark; ship SAMPLE-BENCHMARK-REPORT.md instead
    "runs/summary.md",                # maintainer's internal run summaries
    "runs/summary.csv",
    "PORTKEY-SETUP.md",               # internal Portkey routing notes
    "portkey-probe.sh",               # internal Portkey probe
    "generate-opencode",              # experimental alt generator (untracked)
    "verifier/qc-pinned-contracts/candidate-scores",  # prior internal run scores
    "verifier/qc-pinned-contracts/RUN_LOG.md",        # internal build log
}


def git(*args: str) -> bytes:
    return subprocess.check_output(["git", *args], cwd=ROOT)


def package_files() -> list[Path]:
    payload = git("ls-files", "-z", "--cached", "--others", "--exclude-standard")
    files = []
    for raw in payload.split(b"\0"):
        if not raw:
            continue
        relative = Path(os.fsdecode(raw))
        value = relative.as_posix()
        if value in REJECTED or any(value == item or value.startswith(f"{item}/") for item in REJECTED):
            continue
        path = ROOT / relative
        if path.is_file() and not path.is_symlink():
            files.append(relative)
    return sorted(files, key=lambda item: item.as_posix())


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output-dir", type=Path, default=ROOT / "dist")
    parser.add_argument("--name", default=DEFAULT_NAME)
    parser.add_argument("--allow-dirty", action="store_true")
    args = parser.parse_args()

    if not args.allow_dirty and git("status", "--porcelain").strip():
        print("working tree is not clean; commit changes or use --allow-dirty for local testing", file=sys.stderr)
        return 2
    if not args.name or PurePosixPath(args.name).name != args.name:
        print("--name must be one directory name", file=sys.stderr)
        return 2

    files = package_files()
    required = {
        Path("README.md"),
        Path("environment/Dockerfile"),
        Path("tasks/lab-sample-pickup-and-delivery/instruction.md"),
        Path("tasks/lab-sample-pickup-and-delivery/openapi.contract.json"),
        Path("verifier/qc-pinned-contracts/engine/run.py"),
        Path("verify"),
        Path("generate"),
    }
    missing = sorted(required - set(files))
    if missing:
        print(f"required package files are missing: {', '.join(map(str, missing))}", file=sys.stderr)
        return 2

    output_dir = args.output_dir.expanduser().resolve()
    output_dir.mkdir(parents=True, exist_ok=True)
    archive = output_dir / f"{args.name}.zip"
    checksum = archive.with_suffix(".zip.sha256")
    commit = git("rev-parse", "HEAD").decode().strip()
    branch = git("branch", "--show-current").decode().strip()
    manifest = (
        "HackerRank Amazon RL Gym pilot evaluator package\n"
        f"Source branch: {branch}\n"
        f"Source commit: {commit}\n"
        f"Files: {len(files)}\n"
    ).encode()

    with zipfile.ZipFile(archive, "w", compression=zipfile.ZIP_DEFLATED, compresslevel=9) as bundle:
        entries: list[tuple[str, bytes, int]] = [
            (f"{args.name}/PACKAGE-MANIFEST.txt", manifest, 0o644),
        ]
        for relative in files:
            mode = 0o755 if os.access(ROOT / relative, os.X_OK) else 0o644
            entries.append((f"{args.name}/{relative.as_posix()}", (ROOT / relative).read_bytes(), mode))
        for name, payload, mode in sorted(entries):
            info = zipfile.ZipInfo(name, date_time=(2026, 7, 23, 0, 0, 0))
            info.compress_type = zipfile.ZIP_DEFLATED
            info.external_attr = mode << 16
            info.create_system = 3
            bundle.writestr(info, payload, compress_type=zipfile.ZIP_DEFLATED, compresslevel=9)

    digest = hashlib.sha256(archive.read_bytes()).hexdigest()
    checksum.write_text(f"{digest}  {archive.name}\n", encoding="utf-8")
    print(archive)
    print(checksum)
    print(f"sha256: {digest}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
