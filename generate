#!/usr/bin/env bash
# Compatibility alias for the canonical ASTRA candidate generator.
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$root"

provider="${GEN_PROVIDER:-codex}"
case "$provider" in
  codex) provider="codex" ;;
  portkey|openai) provider="openai-compatible" ;;
  claude) provider="claude-code" ;;
  openai-compatible|claude-code) : ;;
  *) echo "unsupported provider: $provider" >&2; exit 2 ;;
esac

model="${GEN_MODEL:-${CODEX_MODEL:-gpt-5.6-terra}}"
reasoning="${CODEX_REASONING:-medium}"
args=(--task tasks --runs-root "${RUNS_ROOT:-runs}" --provider "$provider" --model "$model" --reasoning "$reasoning")

while (($#)); do
  case "$1" in
    --provider)
      case "${2:-}" in
        codex) provider="codex" ;;
        portkey|openai) provider="openai-compatible" ;;
        claude) provider="claude-code" ;;
        openai-compatible|claude-code) provider="${2}" ;;
        *) echo "unsupported provider: ${2:-}" >&2; exit 2 ;;
      esac
      args+=(--provider "$provider"); shift 2 ;;
    --model) args+=(--model "${2:-}"); shift 2 ;;
    --reasoning) args+=(--reasoning "${2:-}"); shift 2 ;;
    --label|--run-id) args+=(--run-id "${2:-}"); shift 2 ;;
    --env-file|--auth-file|--claude-credentials-file|--cloud-config-file|--ca-cert|--image|--dockerfile|--timeout-seconds|--command)
      args+=("$1" "${2:-}"); shift 2 ;;
    --help|-h)
      echo "Usage: ./generate [ASTRA generation options]"
      echo "Canonical equivalent: python3 -m astra_harness.generate --task tasks ..."
      exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

exec python3 -m astra_harness.generate "${args[@]}"
