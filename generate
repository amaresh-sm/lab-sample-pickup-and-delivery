#!/usr/bin/env bash
# generate — produce ONE candidate solution into runs/<label>-<UTC>/solution/.
#
# A friendly wrapper around ./generate-agent-solution (which does the containerised
# generation and preserves the claude/codex/portkey provider + auth logic). This script
# only picks the provider/model/reasoning, names the run folder, and records metadata.
#
# Produces:
#   runs/<label>-<UTC>/solution/workspace          built app + verification/
#   runs/<label>-<UTC>/solution/codex.log          full generation transcript
#   runs/<label>-<UTC>/solution/run-metadata.json  provider/model/reasoning/timing/tokens
#
# Usage:
#   ./generate                                       # label "sol"; default Codex/ChatGPT
#   ./generate --label gpt5.6-terra                  # custom folder label
#   ./generate --model gpt-5.6-terra --reasoning high
#   ./generate --provider codex   --model gpt-5.6-luna
#   ./generate --provider portkey --label pk         # route via Portkey (config picks the model)
#   ./generate --provider openai  --model gpt-4o     # OpenAI direct (needs OPENAI_API_KEY)
#   ./generate --provider claude  --model claude-opus-4-8 --reasoning high
#
# Flags:
#   --provider claude|codex|portkey|openai   generation backend (default: verifier.env's GEN_PROVIDER)
#   --model <id>                             model id for the chosen backend
#   --reasoning low|medium|high              reasoning effort
#   --label <name>                           run-folder label (auto: provider-model-reasoning)
#   --env-file <file>                        provider settings file (default: verifier.env)
#   --run-dir <dir>                          explicit output run dir (used by ./evaluate)
#   --help
set -Eeuo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"; cd "$root"

label=""; model=""; reasoning=""; provider=""; env_file=""; run_dir=""
while (($#)); do
  case "$1" in
    --label)     label="${2:-}"; shift 2 ;;
    --model)     model="${2:-}"; shift 2 ;;
    --reasoning) reasoning="${2:-}"; shift 2 ;;
    --provider)  provider="${2:-}"; shift 2 ;;
    --env-file)  env_file="${2:-}"; shift 2 ;;
    --run-dir)   run_dir="${2:-}"; shift 2 ;;
    --help|-h)   sed -n '2,29p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# --provider overrides verifier.env's GEN_PROVIDER for THIS run (empty = keep verifier.env's setting).
case "$provider" in
  "")      : ;;                          # keep whatever verifier.env has
  codex)   export GEN_PROVIDER="" ;;     # force default Codex/ChatGPT
  portkey) export GEN_PROVIDER="portkey" ;;
  openai)  export GEN_PROVIDER="openai" ;;
  claude)  export GEN_PROVIDER="claude" ;;
  *) echo "unknown --provider: $provider (use codex|portkey|openai|claude)" >&2; exit 2 ;;
esac
# --model applies to whichever backend runs: CODEX_MODEL (codex) and GEN_MODEL (portkey/openai/claude).
if [[ -n "$model" ]]; then export CODEX_MODEL="$model"; export GEN_MODEL="$model"; fi
[[ -n "$reasoning" ]] && export CODEX_REASONING="$reasoning"
[[ -n "$env_file" ]] && export VERIFIER_ENV_FILE="$env_file"

# Auto-label from provider+model+reasoning when not given (mirrors the old new-run behaviour).
if [[ -z "$label" ]]; then
  label="${provider:+$provider-}${model:-sol}"
  [[ -n "$reasoning" ]] && label="${label}-${reasoning}"
fi
label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '-')"     # folder-safe
export GEN_LABEL="$label"                                      # recorded into run-metadata.json

# Run folder: caller (./evaluate) may pin it via --run-dir; otherwise mint a fresh one.
if [[ -z "$run_dir" ]]; then
  run_id="${label}-$(date -u +%Y%m%dT%H%M%SZ)"
  run_dir="$root/runs/$run_id"
fi
mkdir -p "$run_dir"
echo "[generate] out dir : $run_dir"
echo "RUN_DIR=$run_dir"     # stable, greppable line so ./evaluate can locate the folder

# Delegate the real containerised generation. generate-agent-solution creates
# $AGENT_SOLUTION_OUTPUT_DIR itself and refuses to clobber an existing one.
set +e
AGENT_SOLUTION_OUTPUT_DIR="$run_dir/solution" ./generate-agent-solution
gen_status=$?
set -e
[[ "$gen_status" -ne 0 ]] && echo "[generate] note: generation exited $gen_status (metadata + artifacts still written)" >&2

# Final summary: pull duration + tokens back out of the metadata the generator wrote.
meta="$run_dir/solution/run-metadata.json"
duration="?"; tokens="not captured"
if [[ -f "$meta" ]]; then
  duration="$(jq -r '.durationSeconds // "?"' "$meta" 2>/dev/null || echo '?')"
  if jq -e '.tokens != null' "$meta" >/dev/null 2>&1; then
    tokens="$(jq -r '"in=\(.tokens.input // "?") out=\(.tokens.output // "?") total=\(.tokens.total // "?")"' "$meta")"
  fi
fi
echo
echo "[generate] done"
echo "  run dir : $run_dir"
echo "  duration: ${duration}s"
echo "  tokens  : ${tokens}"
exit "$gen_status"
