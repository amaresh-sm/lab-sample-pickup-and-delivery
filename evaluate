#!/usr/bin/env bash
# Canonical ASTRA end-to-end flow: generate, verify, then normalize the score.
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$root"

run_id=""
generate_args=()
verify_args=()
provider="${GEN_PROVIDER:-codex}"
model="${GEN_MODEL:-${CODEX_MODEL:-gpt-5.6-terra}}"
reasoning="${CODEX_REASONING:-medium}"
while (($#)); do
  case "$1" in
    --label|--run-id) run_id="${2:-}"; shift 2 ;;
    --provider) provider="${2:-}"; generate_args+=(--provider "${2:-}"); shift 2 ;;
    --model) model="${2:-}"; generate_args+=(--model "${2:-}"); shift 2 ;;
    --reasoning) reasoning="${2:-}"; generate_args+=(--reasoning "${2:-}"); shift 2 ;;
    --candidates-root) candidates_root_override="${2:-}"; shift 2 ;;
    --env-file) generate_args+=(--env-file "${2:-}"); verify_args+=(--env-file "${2:-}"); shift 2 ;;
    --auth-file|--claude-credentials-file|--cloud-config-file|--ca-cert|--image|--dockerfile|--command)
      generate_args+=("$1" "${2:-}"); shift 2 ;;
    --verifier-image) verify_args+=(--image "${2:-}"); shift 2 ;;
    --runtime-image|--candidate-env-file|--admin-user|--admin-pass|--unassigned-search-timeout-seconds|--assignment-offer-ttl-seconds|--maintenance-interval-milliseconds)
      verify_args+=("$1" "${2:-}"); shift 2 ;;
    --timeout-seconds)
      generate_args+=(--timeout-seconds "${2:-}"); verify_args+=(--timeout-seconds "${2:-}"); shift 2 ;;
    --help|-h)
      echo "Usage: ./evaluate [generation and verifier options]"
      echo "Output: candidates/<run-id>/"
      exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [[ -z "$run_id" ]]; then
  run_id="${provider}-${model}-${reasoning}-$(date -u +%Y%m%dT%H%M%SZ)"
fi
run_id="$(printf '%s' "$run_id" | tr -c 'A-Za-z0-9._-' '-')"
candidates_root="${candidates_root_override:-${CANDIDATES_ROOT:-candidates}}"
run_dir="$root/$candidates_root/$run_id"

generate_args+=(--candidates-root "$candidates_root" --provider "$provider" --model "$model" --reasoning "$reasoning" --run-id "$run_id")
set +e
"$root/generate-candidate-solution" "${generate_args[@]}"
generation_status=$?
set -e

set +e
"$root/verify" --workspace "$run_dir/candidate" --run "$run_dir" "${verify_args[@]}"
verification_status=$?
set -e

score_status=1
if [[ -f "$run_dir/reports/criteria.json" ]]; then
  set +e
  python3 -m astra_harness.score --task tasks --run "$run_dir"
  score_status=$?
  set -e
fi

echo "generation exit: $generation_status"
echo "verification exit: $verification_status"
echo "score exit: $score_status"
echo "run directory: $run_dir"
exit "$verification_status"
