#!/usr/bin/env bash
# evaluate — end-to-end: generate ONE candidate solution, then verify it, into a single
# runs/<label>-<UTC>/ folder holding both solution/ and verifier-logs/.
#
# Thin orchestrator over ./generate and ./verify. All generation flags pass straight through.
#
# Produces:
#   runs/<id>/solution/       (from ./generate)
#   runs/<id>/verifier-logs/  (from ./verify: reward.json, verify-metadata.json, *.log)
#
# Usage:
#   ./evaluate
#   ./evaluate --provider claude --model claude-opus-4-8 --reasoning high
#   ./evaluate --provider portkey --label pk
#
# Flags (same as ./generate):
#   --provider claude|codex|portkey|openai   --model <id>   --reasoning low|medium|high
#   --label <name>   --env-file <file>
#   --admin-user U   --admin-pass P          (passed to ./verify)
#   --help
set -Eeuo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"; cd "$root"

# Split args: generation flags go to ./generate, admin flags go to ./verify.
gen_args=(); admin_user=""; admin_pass=""
label=""; model=""; reasoning=""; provider=""
while (($#)); do
  case "$1" in
    --label)     label="${2:-}"; gen_args+=(--label "${2:-}"); shift 2 ;;
    --model)     model="${2:-}"; gen_args+=(--model "${2:-}"); shift 2 ;;
    --reasoning) reasoning="${2:-}"; gen_args+=(--reasoning "${2:-}"); shift 2 ;;
    --provider)  provider="${2:-}"; gen_args+=(--provider "${2:-}"); shift 2 ;;
    --env-file)  gen_args+=(--env-file "${2:-}"); shift 2 ;;
    --admin-user) admin_user="${2:-}"; shift 2 ;;
    --admin-pass) admin_pass="${2:-}"; shift 2 ;;
    --help|-h)   sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

# Pin the run folder here so generate + verify land in the SAME runs/<id>/.
if [[ -z "$label" ]]; then
  label="${provider:+$provider-}${model:-sol}"
  [[ -n "$reasoning" ]] && label="${label}-${reasoning}"
fi
label="$(printf '%s' "$label" | tr -c 'A-Za-z0-9._-' '-')"
run_id="${label}-$(date -u +%Y%m%dT%H%M%SZ)"
run_dir="$root/runs/$run_id"
echo "[evaluate] run dir: $run_dir"

# ---- 1. generate ----
set +e
./generate "${gen_args[@]}" --run-dir "$run_dir"
gen_status=$?
set -e
[[ "$gen_status" -ne 0 ]] && echo "[evaluate] note: generation exited $gen_status; verifying anyway" >&2

# ---- 2. verify ----
verify_args=(--workspace "$run_dir/solution/workspace" --logs-dir "$run_dir/verifier-logs")
[[ -n "$admin_user" ]] && verify_args+=(--admin-user "$admin_user")
[[ -n "$admin_pass" ]] && verify_args+=(--admin-pass "$admin_pass")
set +e
./verify "${verify_args[@]}"
verify_status=$?
set -e

# ---- combined summary ----
gen_meta="$run_dir/solution/run-metadata.json"
ver_meta="$run_dir/verifier-logs/verify-metadata.json"
gen_dur="?"; gen_tokens="not captured"; ver_dur="?"; score="?"
if [[ -f "$gen_meta" ]]; then
  gen_dur="$(jq -r '.durationSeconds // "?"' "$gen_meta" 2>/dev/null || echo '?')"
  jq -e '.tokens != null' "$gen_meta" >/dev/null 2>&1 && \
    gen_tokens="$(jq -r '"in=\(.tokens.input // "?") out=\(.tokens.output // "?") total=\(.tokens.total // "?")"' "$gen_meta")"
fi
if [[ -f "$ver_meta" ]]; then
  ver_dur="$(jq -r '.durationSeconds // "?"' "$ver_meta" 2>/dev/null || echo '?')"
  score="$(jq -r '.overallScore // "?"' "$ver_meta" 2>/dev/null || echo '?')"
fi

echo
echo "==================== evaluate summary ===================="
echo "  run dir            : $run_dir"
echo "  generation duration: ${gen_dur}s"
echo "  generation tokens  : ${gen_tokens}"
echo "  verifier duration  : ${ver_dur}s"
echo "  overall score      : ${score}"
echo "=========================================================="
exit "$verify_status"
