# Candidate generations and verifier reports are run artifacts, not task source.
/runs/*
!/runs/summary.md
!/runs/summary.csv
dist/
/candidates/
verifier/reference-solution/dist-server/

# Generated Python bytecode and test caches.
__pycache__/
*.py[cod]
.pytest_cache/

# Legacy local credentials, staging copies, and verifier runtime output.
.plan/
.demo-runtime/
.claude/worktrees/
.coverage
.coverage.*
htmlcov/
verifier/verifier.env
verifier.env
candidate-workspace/
verifier-results/
.DS_Store
.env-runtime/
verifier/**/.venv/
verifier/**/node_modules/
verifier/**/_inputs/
verifier/**/_codebase/
verifier/**/results.json
verifier/**/test-results/
verifier/**/playwright-report/
verifier/**/.pytest_cache/
verifier/**/*.bak-*/
verifier/score.json
verifier/score.md
/solution-run/
/.golden-vue-mongo-work/
/.golden-vue-mongo-results/
/verifier-logs/
verifier/__pycache__/

# Keep compact, reviewed proof metadata and score ledgers; ignore bulky logs and
# transient browser/backend output. Evidence must come from this task's verifier.
/verifier/proof-of-work/**/*.log
/verifier/proof-of-work/**/logs/
/verifier/proof-of-work/**/reports/*
!/verifier/proof-of-work/**/reports/score.json
!/verifier/proof-of-work/**/reports/backend/
!/verifier/proof-of-work/**/reports/backend/reward.json
/verifier/proof-of-work/**/criteria.json
/verifier/proof-of-work/**/assertion.txt
