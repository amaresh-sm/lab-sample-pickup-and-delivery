#!/usr/bin/env bash
# run-ui — boot a built solution in a throwaway container and score its
# PRESENTATION layer with the deterministic UI verifier
# (verifier/qc-pinned-contracts/engine/ui_capabilities/run_ui.py).
#
# Companion to ./verify (which scores the HTTP/API contract). This drives a
# headless, network-isolated Chromium INSIDE the container (same network
# namespace as the app, which binds the frontend to loopback per the manifest),
# seeds known state over HTTP first, and writes a SEPARATE <logs-dir>/ui-reward.json
# sub-score so the UI score reads independently of the API score.
#
# The browser and its Chromium come from the base image (@playwright + the
# /ms-playwright browser bundle); this wrapper adds the python `playwright`
# package into the image's venv at boot (the one setup step that needs the
# network — the SCORING browser run itself is network-isolated at the browser
# layer by the verifier's NetworkGate).
#
# Usage:
#   ./run-ui --workspace runs/<id>/solution/workspace
#   ./run-ui --workspace DIR [--logs-dir DIR] [--image TAG] [--admin-user U] [--admin-pass P]
set -Eeuo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"; cd "$root"

workspace=""; logs_dir=""
image="${IMAGE_TAG:-lab-sample-pickup-delivery-gym:local}"
admin_user="${ADMIN_USERNAME:-admin}"
admin_pass="${ADMIN_PASSWORD:-admin123}"
contract="tasks/lab-sample-pickup-and-delivery/openapi.contract.json"
ui_scorer="verifier/qc-pinned-contracts/engine/ui_capabilities/run_ui.py"
pw_version="${PLAYWRIGHT_PY_VERSION:-1.61.0}"   # python playwright matching /ms-playwright chromium-1228
ready_timeout="${READY_TIMEOUT_SECONDS:-180}"

while (($#)); do
  case "$1" in
    --workspace)  workspace="${2:-}"; shift 2 ;;
    --logs-dir)   logs_dir="${2:-}"; shift 2 ;;
    --image)      image="${2:-}"; shift 2 ;;
    --admin-user) admin_user="${2:-}"; shift 2 ;;
    --admin-pass) admin_pass="${2:-}"; shift 2 ;;
    --help|-h)    sed -n '2,26p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

[[ -n "$workspace" ]] || { echo "--workspace is required" >&2; exit 2; }
[[ -d "$workspace" ]] || { echo "workspace not found: $workspace" >&2; exit 2; }
workspace="$(cd "$workspace" && pwd -P)"
manifest="$workspace/verification/manifest.json"
[[ -f "$manifest" ]] || { echo "no built solution: $manifest is missing" >&2; exit 2; }

if [[ -z "$logs_dir" ]]; then
  if [[ "$(basename "$workspace")" == "workspace" && "$(basename "$(dirname "$workspace")")" == "solution" ]]; then
    logs_dir="$(dirname "$(dirname "$workspace")")/verifier-logs"
  else
    logs_dir="$root/verifier-logs"
  fi
fi
mkdir -p "$logs_dir"; logs_dir="$(cd "$logs_dir" && pwd -P)"

docker image inspect "$image" >/dev/null 2>&1 || {
  echo "base image missing: $image (build: docker build -t $image -f environment/Dockerfile .)" >&2; exit 2; }

# ---- parse manifest (bash 3.2-safe) ----
build_cmd=(); while IFS= read -r l; do build_cmd+=("$l"); done < <(jq -r '.commands.build[]' "$manifest")
reset_cmd=(); while IFS= read -r l; do reset_cmd+=("$l"); done < <(jq -r '.commands.reset[]' "$manifest")
start_cmd=(); while IFS= read -r l; do start_cmd+=("$l"); done < <(jq -r '.commands.start[]' "$manifest")
frontend_url="$(jq -r '.urls.frontend // .urls.api' "$manifest")"
api_url="$(jq -r '.urls.api' "$manifest")"
ready_url="$(jq -r '.urls.ready' "$manifest")"
[[ ${#start_cmd[@]} -gt 0 ]] || { echo "manifest has no commands.start" >&2; exit 2; }
[[ -n "$frontend_url" && "$frontend_url" != "null" ]] || { echo "manifest has no urls.frontend" >&2; exit 2; }

# base-url for the HTTP seeder is the server ORIGIN (see ./verify for why).
base_origin="$(printf '%s' "$api_url" | sed -E 's#^(https?://[^/]+).*#\1#')"

container="run-ui-$(date -u +%Y%m%dT%H%M%SZ)-$$"
cleanup() { docker rm --force "$container" >/dev/null 2>&1 || true; }
trap cleanup EXIT

echo "[run-ui] image     = $image"
echo "[run-ui] workspace = $workspace"
echo "[run-ui] frontend  = $frontend_url"

docker run --detach --name "$container" \
  --env "ADMIN_USERNAME=$admin_user" --env "ADMIN_PASSWORD=$admin_pass" \
  --env "UNASSIGNED_SEARCH_TIMEOUT_SECONDS=${UNASSIGNED_SEARCH_TIMEOUT_SECONDS:-60}" \
  --env "ASSIGNMENT_OFFER_TTL_SECONDS=${ASSIGNMENT_OFFER_TTL_SECONDS:-120}" \
  --env "MAINTENANCE_INTERVAL_MILLISECONDS=${MAINTENANCE_INTERVAL_MILLISECONDS:-1000}" \
  --mount "type=bind,src=$workspace,dst=/workspace" \
  --mount "type=bind,src=$root,dst=/opt/gym,readonly" \
  --mount "type=bind,src=$logs_dir,dst=/logs" \
  "$image" sleep infinity >/dev/null

echo "[run-ui] waiting for datastores..."
dl=$(( $(date +%s) + 60 ))
until docker exec "$container" /opt/arena/bin/healthcheck.sh >/dev/null 2>&1; do
  (( $(date +%s) >= dl )) && { echo "datastores never healthy" >&2; exit 1; }; sleep 2
done

echo "[run-ui] build..."
docker exec --workdir /workspace "$container" "${build_cmd[@]}" 2>&1 | tee "$logs_dir/ui-build.log" || { echo "build failed" >&2; exit 1; }
echo "[run-ui] reset..."
docker exec --workdir /workspace "$container" "${reset_cmd[@]}" 2>&1 | tee "$logs_dir/ui-reset.log" || { echo "reset failed" >&2; exit 1; }

start_quoted=""; for a in "${start_cmd[@]}"; do start_quoted="$start_quoted $(printf '%q' "$a")"; done
echo "[run-ui] start (background)..."
docker exec --detach "$container" bash -lc "cd /workspace && exec$start_quoted >/logs/ui-app-start.log 2>&1"

echo "[run-ui] waiting for ready (timeout ${ready_timeout}s)..."
ready=0; dl=$(( $(date +%s) + ready_timeout ))
while (( $(date +%s) < dl )); do
  body="$(docker exec "$container" curl -fsS "$ready_url" 2>/dev/null || true)"
  printf '%s' "$body" | jq -e '.status == "ready"' >/dev/null 2>&1 && { ready=1; break; }; sleep 3
done
[[ "$ready" -eq 1 ]] || { echo "[run-ui] app never reported ready" >&2; docker exec "$container" tail -n 40 /logs/ui-app-start.log >&2 || true; exit 1; }

# One-time setup: python playwright, reusing the base image's /ms-playwright chromium.
echo "[run-ui] installing python playwright ($pw_version) into the image venv..."
docker exec -u root "$container" /opt/arena/venv/bin/pip install --no-cache-dir "playwright==$pw_version" >/dev/null

echo "[run-ui] scoring UI..."
docker exec -e PLAYWRIGHT_BROWSERS_PATH=/ms-playwright --workdir /opt/gym "$container" \
  /opt/arena/venv/bin/python "$ui_scorer" \
    --frontend-url "$frontend_url" --base-url "$base_origin" --contract "$contract" \
    --manifest /workspace/verification/manifest.json \
    --admin-user "$admin_user" --admin-pass "$admin_pass" \
    score --verbose --json-out /logs/ui-reward.json 2>&1 | tee "$logs_dir/ui-engine.log" || true

overall="$(jq -r '.overall // "null"' "$logs_dir/ui-reward.json" 2>/dev/null || echo null)"
echo
echo "[run-ui] done"
echo "  UI overall score : $overall"
echo "  ui-reward.json   : $logs_dir/ui-reward.json"
