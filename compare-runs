#!/usr/bin/env bash
# compare-runs — aggregate every runs/<id>/ into one side-by-side leaderboard.
# Writes runs/summary.md and runs/summary.csv, and prints the table.
set -Eeuo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"; cd "$root"

python3 - "$root" <<'PY'
import csv, glob, json, os, sys

root = sys.argv[1]
runs_dir = os.path.join(root, "runs")

def load(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return {}

rows = []
for d in sorted(glob.glob(os.path.join(runs_dir, "*" + os.sep))):
    rid = os.path.basename(d.rstrip(os.sep))
    reward = load(os.path.join(d, "verifier-logs", "reward.json"))
    result = load(os.path.join(d, "verifier-logs", "complete-verifier-result.json"))
    meta = load(os.path.join(d, "solution", "run-metadata.json"))
    failed = [s.get("name") for s in result.get("stages", []) if s.get("exitCode") not in (0, None)]
    rows.append({
        "run": rid,
        "model": meta.get("model", ""),
        "status": result.get("status", "n/a"),
        "solved": reward.get("solved"),
        "reward": reward.get("reward"),
        "failed_stages": ",".join(x for x in failed if x) or "-",
    })

os.makedirs(runs_dir, exist_ok=True)
fields = ["run", "model", "status", "solved", "reward", "failed_stages"]
with open(os.path.join(runs_dir, "summary.csv"), "w", newline="") as f:
    w = csv.DictWriter(f, fieldnames=fields)
    w.writeheader()
    w.writerows(rows)

lines = ["# Runs summary", "",
         "| run | model | status | solved | reward | failed stages |",
         "|---|---|---|---|---|---|"]
for r in rows:
    lines.append(f"| {r['run']} | {r['model']} | {r['status']} | {r['solved']} | {r['reward']} | {r['failed_stages']} |")
with open(os.path.join(runs_dir, "summary.md"), "w") as f:
    f.write("\n".join(lines) + "\n")

print("\n".join(lines))
print(f"\n[compare-runs] wrote runs/summary.md and runs/summary.csv  ({len(rows)} run(s))")
PY
