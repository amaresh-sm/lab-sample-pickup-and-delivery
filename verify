#!/usr/bin/env bash
# Compatibility alias for the canonical ASTRA verifier.
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$root"

workspace=""
run_dir=""
args=(--task tasks --verifier-command "python3 /input/verifier/run.py")
while (($#)); do
  case "$1" in
    --workspace|--candidate) workspace="${2:-}"; shift 2 ;;
    --logs-dir|--run) run_dir="${2:-}"; shift 2 ;;
    --image|--runtime-image|--env-file|--candidate-env-file|--timeout-seconds|--admin-user|--admin-pass|--unassigned-search-timeout-seconds|--assignment-offer-ttl-seconds|--maintenance-interval-milliseconds)
      args+=("$1" "${2:-}"); shift 2 ;;
    --help|-h)
      echo "Usage: ./verify --workspace benchmarking-candidates/<run-id>/candidate [--run DIR]"
      echo "Canonical equivalent: python3 -m astra_harness.verify --task tasks ..."
      exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

[[ -n "$workspace" ]] || { echo "--workspace is required" >&2; exit 2; }
[[ -n "$run_dir" ]] || run_dir="$(dirname "$(cd "$workspace" && pwd -P)")"
args+=(--candidate "$workspace" --run "$run_dir")
exec python3 -m astra_harness.verify "${args[@]}"
