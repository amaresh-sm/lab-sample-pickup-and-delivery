#!/usr/bin/env bash
# generate-opencode — generate a candidate solution with OpenCode driving a
# Portkey (openai-compatible) provider, mirroring the manual recipe:
#
#   curl -fsSL https://opencode.ai/install | bash
#   ~/.config/opencode/opencode.json:
#     provider.portkey.npm = @ai-sdk/openai-compatible
#     options.baseURL = https://api.portkey.ai/v1
#     options.headers."x-portkey-api-key" = <OPENAI_API_KEY from verifier.env>
#     models.<MODEL> ; model = portkey/<MODEL>
#   opencode run "<task prompt>"
#
# Same container ISOLATION as ./generate: mounts ONLY the candidate workspace
# (instruction.md + pinned openapi.contract.json). OpenCode's cache/config/data
# go to /tmp (NOT /workspace) so the produced workspace stays clean.
#
# Usage:
#   ./generate-opencode                       # default model grok-4.3
#   ./generate-opencode --model grok-4.3 --label oc-grok
#   ./generate-opencode --model z-ai/glm-4.6  # (will fall back to gpt-5.6-sol on this key — see probes)
set -Eeuo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"; cd "$root"

model="grok-4.3"; label=""
while (($#)); do
  case "$1" in
    --model) model="${2:?}"; shift 2 ;;
    --label) label="${2:?}"; shift 2 ;;
    -h|--help) sed -n '2,26p' "$0"; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# --- provider settings from verifier.env (the Portkey token) ---
[[ -f verifier.env ]] || { echo "verifier.env missing" >&2; exit 2; }
set -a; source verifier.env; set +a
: "${OPENAI_API_KEY:?verifier.env needs OPENAI_API_KEY (the Portkey token)}"
base_url="${OPENAI_BASE_URL:-https://api.portkey.ai/v1}"

image="${CODEX_IMAGE:-lab-sample-pickup-delivery-gym:codex-local}"
prompt_file="verifier/amazon-test/full-solution-prompt.md"
[[ -f "$prompt_file" ]] || { echo "missing prompt: $prompt_file" >&2; exit 2; }

run_id="$(date -u +%Y%m%dT%H%M%SZ)"
safe_label="${label:-oc-$(printf '%s' "$model" | tr '/:' '--')}"
run_dir="runs/${safe_label}-${run_id}/solution"
workspace="$run_dir/workspace"; mkdir -p "$workspace"; chmod 0777 "$workspace"
cp tasks/lab-sample-pickup-and-delivery/instruction.md "$workspace/instruction.md"; chmod 0444 "$workspace/instruction.md"
cp tasks/lab-sample-pickup-and-delivery/openapi.contract.json "$workspace/openapi.contract.json"; chmod 0444 "$workspace/openapi.contract.json"
workspace_abs="$(cd "$workspace" && pwd -P)"

container="agent-solution-${safe_label}-${run_id}"
cleanup(){ docker rm -f "$container" >/dev/null 2>&1 || true; }
trap cleanup EXIT

echo "[opencode] model=$model  base=$base_url"
echo "[opencode] run dir=$run_dir  container=$container"

# ISOLATION: mount ONLY the workspace (no repo, no verifier, no golden).
docker run --detach --name "$container" \
  --mount "type=bind,src=$workspace_abs,dst=/workspace" \
  "$image" sleep infinity >/dev/null

# Fix the npm cache perms: the image's /home/agent/.npm is root-owned, so npm
# install (OpenCode plugins AND the candidate's frontend) fails EACCES as agent.
# Give agent a clean, owned npm cache so frontend builds can actually run.
docker exec --user root "$container" bash -lc 'mkdir -p /tmp/npmcache && chown -R agent:agent /tmp/npmcache /home/agent/.npm 2>/dev/null; true'

echo "[opencode] installing OpenCode (as agent)..."
docker exec --user agent "$container" bash -lc \
  'curl -fsSL https://opencode.ai/install | bash >/tmp/oc-install.log 2>&1 && echo INSTALL_OK || { echo INSTALL_FAIL; tail -20 /tmp/oc-install.log; exit 1; }'
oc_bin="$(docker exec --user agent "$container" bash -lc 'ls /home/agent/.opencode/bin/opencode 2>/dev/null || command -v opencode' | head -1)"
[[ -n "$oc_bin" ]] || { echo "opencode binary not found after install" >&2; exit 1; }
echo "[opencode] binary: $oc_bin  version: $(docker exec --user agent "$container" "$oc_bin" --version 2>/dev/null | head -1)"

# --- write the Portkey provider config (openai-compatible) with the real token + model ---
config_json="$(OPENAI_API_KEY="$OPENAI_API_KEY" BASE="$base_url" MODEL="$model" python3 - <<'PY'
import json, os
m = os.environ["MODEL"]
cfg = {
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "portkey": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Portkey",
            "options": {
                "baseURL": os.environ["BASE"],
                "headers": {"x-portkey-api-key": os.environ["OPENAI_API_KEY"]},
            },
            "models": {m: {"name": f"{m} via Portkey"}},
        }
    },
    "model": f"portkey/{m}",
    # Headless generation cannot answer interactive permission prompts, so
    # OpenCode auto-REJECTS them -- which killed a real run when the model read
    # its own scratch file in /tmp (external_directory /tmp auto-rejecting ->
    # disposing instance). The container is already fully isolated (only the
    # candidate workspace is mounted; no repo/verifier/golden), so grant the
    # agent tools freely: allow bash/edit/write/read and any external directory
    # (e.g. a /tmp scratch dir) so the model can actually build.
    "permission": {
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "read": "allow",
        "external_directory": "allow",
        "webfetch": "allow",
    },
}
print(json.dumps(cfg, indent=2))
PY
)"
# place config at the XDG location OpenCode reads (agent-owned, under /tmp/oc)
docker exec --user agent "$container" bash -lc 'mkdir -p /tmp/oc/config/opencode /tmp/oc/cache /tmp/oc/data'
printf '%s' "$config_json" | docker exec -i --user agent "$container" bash -lc 'cat > /tmp/oc/config/opencode/opencode.json'

# task prompt into the container (NOT /workspace, to keep the produced app clean)
docker cp "$prompt_file" "$container:/tmp/task-prompt.md"
docker exec --user root "$container" chown agent:agent /tmp/task-prompt.md

started_epoch="$(date +%s)"
echo "[opencode] running headless generation (opencode run)..."
set +e
docker exec --interactive --user agent \
  --env XDG_CONFIG_HOME=/tmp/oc/config --env XDG_CACHE_HOME=/tmp/oc/cache --env XDG_DATA_HOME=/tmp/oc/data \
  --env npm_config_cache=/tmp/npmcache \
  "$container" bash -lc "cd /workspace && '$oc_bin' run --print-logs \"\$(cat /tmp/task-prompt.md)\"" \
  2>&1 | tee "$run_dir/generation.log"
gen_status="${PIPESTATUS[0]}"
set -e
finished_epoch="$(date +%s)"
dur=$(( finished_epoch - started_epoch ))

echo "[opencode] tamper-check..."
tamper="clean"
grep -rIlE 'enforceNamedSamplePolicy|recordNoQualifiedCollectorException|qc-pinned-contracts|reference-solutions|EnsureNamedSampleTypesSeeded|LX-[AIFP]\b' "$workspace" >/dev/null 2>&1 && tamper="SUSPECT"

python3 - "$run_dir/run-metadata.json" "$model" "$safe_label" "$dur" "$gen_status" "$tamper" <<'PY'
import json,sys
out,model,label,dur,ex,tamper=sys.argv[1:7]
json.dump({"provider":"opencode-portkey","model":model,"reasoning":None,"label":label,
"durationSeconds":int(dur),"exitCode":int(ex),"tokens":None,"tamperCheck":tamper,
"note":"generated via OpenCode + Portkey openai-compatible provider (x-portkey-api-key)"},open(out,"w"),indent=2)
open(out,"a").write("\n")
PY

echo "[opencode] done in ${dur}s (exit $gen_status, tamper $tamper)"
echo "  workspace: $workspace"
echo "  log:       $run_dir/generation.log"
exit "$gen_status"
