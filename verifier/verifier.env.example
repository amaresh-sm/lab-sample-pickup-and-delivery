# Copy this file outside the candidate workspace and restrict it to the evaluator.
# Leave a provider's credentials blank if you won't use it. Pick which provider
# SOLUTION GENERATION uses with GEN_PROVIDER below (or the --provider CLI flag,
# which overrides this file for a single run).
#
# The verifier's OWN scoring engine (python3 -m astra_harness.verify) has NO LLM in its scoring path and
# needs none of these settings -- it is pure deterministic HTTP-contract checking.
# Everything below configures generation only (python3 -m astra_harness.generate).

# ---- Claude (--provider claude) ----------------------------------------------
# A real key is reliable for a long generation; without one, the CLI falls back
# to your host's ~/.claude/.credentials.json login (works, but that OAuth token
# can expire mid-run on a long generation).
ANTHROPIC_API_KEY=

# ---- Codex / ChatGPT (default --provider, or --provider codex) --------------
# Leave blank to use your host's ~/.codex/auth.json (ChatGPT login) instead.
CODEX_AUTH_FILE=

# ---- OpenAI-compatible gateway (--provider openai | portkey) -----------------
# OPENAI_API_KEY doubles as the token for any OpenAI-compatible gateway (e.g.
# Portkey): put the gateway token here and point OPENAI_BASE_URL at the gateway.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1        # for Portkey: https://api.portkey.ai/v1

# --- Portkey gateway (optional; only used when the base URL above is Portkey's)
# Portkey needs a routing header in addition to the token. Set ONE of these
# (CONFIG is preferred) to the value from the Portkey dashboard -- the Configs
# page shows the "pc-..." id, AI Providers shows the slug. Leave the other blank.
PORTKEY_CONFIG=pc-xxxxxxxx      # <-- the Portkey CONFIG ID goes here (preferred)
# PORTKEY_PROVIDER=your-slug    # <-- or an AI-Provider slug instead of a config id

# Route candidate generation through the gateway above (used by astra_harness.generate):
GEN_PROVIDER=openai            # toggle: portkey | openai | claude | (unset = default Codex/ChatGPT)
GEN_MODEL=gpt-4o-mini           # a model your config/provider actually serves
