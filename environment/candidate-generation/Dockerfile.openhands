# syntax=docker/dockerfile:1.7

ARG BASE_IMAGE=astra-candidate-runtime:latest
FROM ${BASE_IMAGE}

ARG OPENHANDS_GATEWAY_DIGEST=unknown
LABEL org.astra.openhands-gateway.digest="${OPENHANDS_GATEWAY_DIGEST}"

USER root
ARG CODEX_VERSION=0.144.6
ARG CLAUDE_CODE_VERSION=latest

RUN npm install --global --ignore-scripts --no-audit --no-fund "@openai/codex@${CODEX_VERSION}" \
    && npm install --global --no-audit --no-fund "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}"

# The named build context is supplied by astra_harness.generate via
# --openhands-gateway-repo. Copy only package sources and metadata; local
# credentials, virtual environments, tests, and Git data never enter the image.
COPY --from=openhands /pyproject.toml /opt/hackerrank-openhands-gateway/pyproject.toml
COPY --from=openhands /README.md /opt/hackerrank-openhands-gateway/README.md
COPY --from=openhands /src/hackerrank_openhands /opt/hackerrank-openhands-gateway/src/hackerrank_openhands

RUN python3 -m pip install --break-system-packages --no-cache-dir /opt/hackerrank-openhands-gateway \
    && install -d -m 0700 -o agent -g agent /home/agent/.codex /home/agent/.claude

USER agent
WORKDIR /workspace
